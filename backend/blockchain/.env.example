# ──── Blockchain Configuration ────
# Copy this file to .env and fill in values

# Set to "true" to enable blockchain writes (default: false = SQLite only)
BLOCKCHAIN_ENABLED=false

# RPC endpoint — use http://127.0.0.1:8545 for local Hardhat/Ganache
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployer private key (without 0x prefix) — NEVER commit real keys
BLOCKCHAIN_PRIVATE_KEY=

# Contract address — set after deploying TraceFundLedger.sol
TRACEFUND_CONTRACT_ADDRESS=

# Chain ID — 31337 for Hardhat local, 80001 for Polygon Mumbai testnet
BLOCKCHAIN_CHAIN_ID=31337
